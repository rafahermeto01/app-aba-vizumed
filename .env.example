# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai para o GitHub.
# Onde achar: painel do Supabase → Project Settings → API (ou "API Keys").

# --- App (vão para o navegador: só valores PÚBLICOS) ---------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública: "anon" (legada) ou "publishable" (sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# --- Só para scripts no seu computador. NUNCA comece com VITE_ -------------------
# Chave secreta: "service_role" (legada) ou "secret" (sb_secret_...)
SUPABASE_SERVICE_ROLE_KEY=

# Primeiro(a) Coordenador(a) — usado uma única vez por: npm run admin:create
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=
FIRST_CLINIC_NAME=

# Senha das 4 contas fictícias de teste — usado por: npm run seed:demo e npm run test:rls
DEMO_PASSWORD=

# Chave da ferramenta do Supabase (CLI) só para este projeto (opcional).
# Painel do Supabase → Account → Access Tokens → Generate new token (escopo: só este projeto)
SUPABASE_ACCESS_TOKEN=
